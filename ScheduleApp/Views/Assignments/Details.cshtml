@model ScheduleApp.Models.Assignment

@{
    ViewData["Title"] = "Деталі завдання";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-5">
        <div class="card-header bg-info text-white p-5 rounded-top-5">
            <h1 class="display-3 fw-bold mb-0">ℹ️ Інформація про завдання</h1>
        </div>
        <div class="card-body p-5">
            <div class="bg-light p-5 rounded-5 shadow-sm mb-5">
                <dl class="row mb-0">
                    <dt class="col-sm-4 display-6 fw-bold text-muted mb-4">Предмет:</dt>
                    <dd class="col-sm-8 display-5 fw-bold mb-4">@Html.DisplayFor(model => model.Subject.Name)</dd>

                    <dt class="col-sm-4 display-6 fw-bold text-muted mb-4">Дедлайн:</dt>
                    <dd class="col-sm-8 display-5 fw-bold text-danger mb-4">
                        @(Model.Deadline?.ToString("dd MMMM yyyy, HH:mm") ?? "Не вказано")
                    </dd>

                    <dt class="col-sm-4 display-6 fw-bold text-muted">Опис:</dt>
                    <dd class="col-sm-8 display-6 text-dark" style="white-space: pre-wrap;">@Html.DisplayFor(model => model.Description)</dd>
                </dl>
            </div>
            
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5 py-4 fs-2 rounded-4">Назад до списку</a>
                <a asp-action="Edit" asp-route-id="@Model.TaskId" class="btn btn-warning btn-lg px-5 py-4 fs-2 rounded-4 fw-bold">Редагувати</a>
            </div>
        </div>
    </div>
</div>