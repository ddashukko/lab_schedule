@model IEnumerable<ScheduleApp.Models.Assignment>

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold display-5 text-secondary">🗄️ Архів завдань</h2>
        <a asp-action="Index" class="btn btn-outline-primary btn-lg shadow-sm fw-bold fs-4">⬅ До активних</a>
    </div>
    
    <div class="card shadow-sm border-0 rounded-4">
        <table class="table table-hover mb-0 w-100" style="table-layout: auto !important;">
            <thead class="table-light fs-4">
                <tr>
                    <th style="width: 15%; padding: 1.5rem;">Статус</th>
                    <th style="width: 25%; padding: 1.5rem;">Предмет</th>
                    <th style="width: 35%; padding: 1.5rem;">Опис завдання</th>
                    <th style="width: 15%; padding: 1.5rem;">Дедлайн</th>
                    <th class="text-end" style="width: 10%; padding: 1.5rem;">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr class="bg-light">
                        <td class="align-middle" style="padding: 1.2rem;">
                            @if(item.Status == "Completed") {
                                <span class="badge bg-success fs-5 px-3 py-2 shadow-sm rounded-pill">✅ Виконано</span>
                            } else {
                                <span class="badge bg-danger fs-5 px-3 py-2 shadow-sm rounded-pill">❌ Не виконано</span>
                            }
                        </td>
                        <td class="align-middle" style="padding: 1.2rem;">
                            <span class="badge bg-secondary px-4 py-3 fs-5 text-wrap shadow-sm" style="max-width: 100%; text-align: left; line-height: 1.4; border-radius: 12px;">
                                @(item.Subject?.Name ?? "---")
                            </span>
                        </td>
                        <td class="text-muted fs-4 align-middle text-decoration-line-through" style="word-break: break-word; padding: 1.2rem; line-height: 1.5;">
                            @item.Description
                        </td>
                        <td class="text-muted fs-4 align-middle" style="padding: 1.2rem;">
                            @item.Deadline?.ToString("dd.MM HH:mm")
                        </td>
                        <td class="text-end align-middle" style="padding: 1.2rem;">
                            <div class="d-flex justify-content-end gap-2 flex-wrap">
                                <form asp-action="ChangeStatus" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.TaskId" />
                                    <input type="hidden" name="status" value="Active" />
                                    <button type="submit" class="btn btn-outline-primary fw-bold fs-5 px-3 py-2" title="Повернути в роботу">🔄</button>
                                </form>
                                <a asp-action="Delete" asp-route-id="@item.TaskId" class="btn btn-outline-danger fw-bold fs-5 px-3 py-2" title="Видалити назавжди">🗑️</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>