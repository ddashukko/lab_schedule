@model ScheduleApp.Models.Assignment

@{
    ViewData["Title"] = "Видалення завдання";
}

<div class="container-fluid px-4 mt-5">
    <div class="card shadow-lg border-0 rounded-5">
        <div class="card-header bg-danger text-white p-5 rounded-top-5">
            <h1 class="display-3 fw-bold mb-0">⚠️ Видалити це завдання?</h1>
        </div>
        <div class="card-body p-5 text-center">
            <h2 class="display-4 mb-5 text-dark">Ви впевнені, що хочете остаточно видалити це завдання?</h2>
            
            <div class="bg-light p-5 rounded-5 shadow-sm mb-5 text-start">
                <dl class="row mb-0 fs-2">
                    <dt class="col-sm-4 fw-bold">Предмет:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Subject.Name)</dd>
                    
                    <dt class="col-sm-4 fw-bold">Опис:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>

                    <dt class="col-sm-4 fw-bold">Дедлайн:</dt>
                    <dd class="col-sm-8 text-danger">@Html.DisplayFor(model => model.Deadline)</dd>
                </dl>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="TaskId" />
                <div class="d-flex justify-content-center gap-5">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5 py-4 fs-2 rounded-4">Скасувати</a>
                    <button type="submit" class="btn btn-danger btn-lg px-5 py-4 fs-2 fw-bold rounded-4 shadow-lg">Так, видалити назавжди</button>
                </div>
            </form>
        </div>
    </div>
</div>