@model IEnumerable<ScheduleApp.Models.Assignment>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📝 Активні завдання</h2>
        <div>
            <a asp-action="Archive" class="btn btn-outline-secondary btn-sm shadow-sm me-2">🗄️ Архів</a>
            <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm">Нове завдання</a>
        </div>
    </div>
    <div class="card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="border-0">Предмет</th>
                    <th class="border-0">Опис завдання</th>
                    <th class="border-0">Дедлайн</th>
                    <th class="border-0 text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td style="width: 200px;">
                            <span class="badge bg-primary rounded-pill px-3 py-2">
                                @(item.Subject?.Name ?? "---")
                            </span>
                        </td>
                        <td class="text-dark">@item.Description</td>
                        <td class="fw-bold text-danger" style="width: 150px;">
                            @item.Deadline?.ToString("dd.MM HH:mm")
                        </td>
                        <td class="text-end" style="width: 220px;">
                            <div class="d-flex justify-content-end gap-1">
                                <form asp-action="ChangeStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.TaskId" />
                                    <input type="hidden" name="status" value="Completed" />
                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Виконано">✅</button>
                                </form>
                                <form asp-action="ChangeStatus" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.TaskId" />
                                    <input type="hidden" name="status" value="Failed" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Не виконано">❌</button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@item.TaskId" class="btn btn-sm btn-outline-secondary" title="Редагувати">✏️</a>
                                <a asp-action="Delete" asp-route-id="@item.TaskId" class="btn btn-sm btn-outline-danger" title="Видалити">🗑️</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>