@model IEnumerable<ScheduleApp.Models.Assignment>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📝 Список завдань</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm">Нове завдання</a>
    </div>
    <div class="card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="border-0">Предмет</th>
                    <th class="border-0">Опис завдання</th>
                    <th class="border-0">Дедлайн</th>
                    <th class="border-0 text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td style="width: 200px;">
                            <span class="badge rounded-pill px-3 py-2" style="background-color: @(item.Subject?.ColorCode ?? "#6c757d"); color: #fff;">
                                @(item.Subject?.Name ?? "---")
                            </span>
                        </td>
                        <td class="text-dark">@item.Description</td>
                        <td class="fw-bold text-danger" style="width: 150px;">
                            @item.Deadline?.ToString("dd.MM HH:mm")
                        </td>
                        <td class="text-end" style="width: 180px;">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.TaskId" class="btn btn-sm btn-light border">✏️</a>
                                <a asp-action="Details" asp-route-id="@item.TaskId" class="btn btn-sm btn-light border">ℹ️</a>
                                <a asp-action="Delete" asp-route-id="@item.TaskId" class="btn btn-sm btn-light border text-danger">🗑️</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>