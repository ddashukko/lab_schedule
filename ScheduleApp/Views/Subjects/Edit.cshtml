@model ScheduleApp.Models.Subject

@{
    ViewData["Title"] = "Редагування предмета";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-5">
        <div class="card-header bg-warning p-5 rounded-top-5">
            <h1 class="display-3 fw-bold mb-0">✏️ Редагувати: @Model.Name</h1>
        </div>
        <div class="card-body p-5">
            <form asp-action="Edit">
                <input type="hidden" asp-for="SubjectId" />
                
                <div class="mb-5">
                    <label asp-for="Name" class="h1 fw-bold mb-3">Назва</label>
                    <input asp-for="Name" class="form-control form-control-lg py-4 fs-1 shadow-sm" />
                </div>

                <div class="mb-5">
                    <label asp-for="ColorCode" class="h1 fw-bold mb-3">Колір</label>
                    <input asp-for="ColorCode" type="color" class="form-control form-control-lg shadow-sm" style="height: 100px;" />
                </div>

                <div class="d-flex justify-content-between mt-5 pt-5 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5 py-4 fs-2 rounded-4">Назад</a>
                    <button type="submit" class="btn btn-warning btn-lg px-5 py-4 fs-2 fw-bold rounded-4 shadow">Оновити</button>
                </div>
            </form>
        </div>
    </div>
</div>