@model IEnumerable<ScheduleApp.Models.Teacher>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">👨‍🏫 Викладачі</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">+ Додати</a>
    </div>
    <div class="card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ПІБ Викладача</th>
                    <th>Посилання</th>
                    <th class="text-end">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td class="fw-bold">@item.FullName</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.TeacherId" class="btn btn-sm btn-outline-warning">Редагувати</a>
                            <a asp-action="Delete" asp-route-id="@item.TeacherId" class="btn btn-sm btn-outline-danger">Видалити</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>