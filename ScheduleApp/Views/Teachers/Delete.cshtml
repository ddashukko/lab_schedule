@model ScheduleApp.Models.Teacher

@{
    ViewData["Title"] = "Видалення викладача";
}

<div class="container mt-5 text-center">
    <div class="card shadow-lg border-0 rounded-5 py-5 px-4">
        <div class="mb-4">
            <span class="display-1 text-danger">🛑</span>
        </div>
        <h1 class="display-2 fw-black text-danger mb-4">Видалити викладача?</h1>
        <p class="display-5 text-muted mb-5">
            Ви збираєтеся видалити профіль викладача: <br>
            <strong class="text-dark">@Model.FullName</strong>
        </p>

        <form asp-action="Delete">
            <input type="hidden" asp-for="TeacherId" />
            <div class="d-flex justify-content-center gap-4 mt-5">
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5 py-4 fs-2 rounded-4">Ні, помилився</a>
                <button type="submit" class="btn btn-danger btn-lg px-5 py-4 fs-2 fw-bold rounded-4 shadow-lg">Так, видалити</button>
            </div>
        </form>
    </div>
</div>