<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/material_blue.css">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Мій Розклад</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/flatly-bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ScheduleApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 py-3">
            <div class="container-fluid px-4">>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark fs-3 fw-bold" asp-controller="Home" asp-action="Index">Розклад</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fs-3 fw-bold" asp-controller="Subjects" asp-action="Index">Предмети</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fs-3 fw-bold" asp-controller="Teachers" asp-action="Index">Викладачі</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fs-3 fw-bold" asp-controller="Assignments" asp-action="Index">Завдання</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fs-3 fw-bold text-primary" asp-controller="Home" asp-action="Statistics">📈 Статистика</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center py-3">
            &copy; 2026 - Мій Розклад
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/uk.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            flatpickr('input[type="date"]', {
                locale: "uk", 
                dateFormat: "Y-m-d", 
                disableMobile: true 
            });
        });
    </script>
</body>
</html>