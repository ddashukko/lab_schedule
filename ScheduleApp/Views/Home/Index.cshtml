@using ScheduleApp.Controllers
@{
    ViewData["Title"] = "Мій Розклад";
    var gridData = ViewBag.GridData as Dictionary<string, Dictionary<DayOfWeek, List<TimetableGridEntry>>> 
                   ?? new Dictionary<string, Dictionary<DayOfWeek, List<TimetableGridEntry>>>();
    var timeSlots = ViewBag.SortedTimeSlots as List<string> ?? new List<string>();
    var days = Enum.GetValues(typeof(DayOfWeek)).Cast<DayOfWeek>().Where(d => d != DayOfWeek.Sunday).ToList();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">📅 Тижневий розклад</h1>
        <a asp-controller="Schedules" asp-action="Create" class="btn btn-primary btn-lg">+ Додати пару</a>
    </div>

    <div class="table-responsive shadow-sm rounded-4">
        <table class="table table-bordered bg-white mb-0">
            <thead class="table-light">
                <tr class="text-center">
                    <th style="width: 100px;">Час</th>
                    @foreach (var day in days) {
                        <th>@day.ToString()</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in timeSlots) {
                    <tr>
                        <td class="text-center align-middle fw-bold bg-light">@slot</td>
                        @foreach (var day in days) {
                            <td class="p-2" style="min-width: 150px; height: 100px;">
                                @if (gridData.ContainsKey(slot) && gridData[slot].ContainsKey(day)) {
                                    @foreach (var entry in gridData[slot][day]) {
                                        <div class="schedule-card border-start border-4 border-primary shadow-sm p-2 mb-2 bg-light rounded">
                                            <div class="d-flex justify-content-between">
                                                <span class="subject-name text-dark">@entry.Record.Subject?.Name</span>
                                                <div class="btn-group">
                                                    <a asp-controller="Schedules" asp-action="Edit" asp-route-id="@entry.Record.EntryId" class="text-warning me-2">✏️</a>
                                                    <form asp-controller="Schedules" asp-action="Delete" asp-route-id="@entry.Record.EntryId" method="post" onsubmit="return confirm('Видалити?')">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="border-0 bg-transparent text-danger p-0">🗑️</button>
                                                    </form>
                                                </div>
                                            </div>
                                            <div class="teacher-name text-muted small">👤 @entry.Record.Teacher?.FullName</div>
                                            
                                            @if (!string.IsNullOrWhiteSpace(entry.Record.Link) && entry.Record.Link.Trim() != "-") {
                                                <a href="@entry.Record.Link" target="_blank" class="btn btn-sm btn-outline-primary w-100 mt-1" style="font-size: 0.75rem;">🔗 Приєднатися</a>
                                            }
                                        </div>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>